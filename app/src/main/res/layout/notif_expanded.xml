<?xml version="1.0" encoding="utf-8"?>
<!-- แจ้งเตือนแบบขยาย: การ์ดสีพีช เวลาตัวใหญ่ ปุ่มใหญ่กดง่าย -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/badge"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:src="@drawable/notif_badge_in" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="#3B2622"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:textColor="#7A6A64"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#6B4237"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_check"
            style="@style/NotifBigButton"
            android:layout_weight="1.3"
            android:background="@drawable/notif_btn_in"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/btn_skip"
            style="@style/NotifBigButton"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_light"
            android:text="ข้าม"
            android:textColor="#6B4237" />

        <TextView
            android:id="@+id/btn_snooze"
            style="@style/NotifBigButton"
            android:layout_marginStart="8dp"
            android:layout_weight="1.2"
            android:background="@drawable/notif_btn_light"
            android:textColor="#6B4237" />
    </LinearLayout>
</LinearLayout>
