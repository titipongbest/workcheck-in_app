<?xml version="1.0" encoding="utf-8"?>
<!-- แจ้งเตือนแบบย่อ: ปุ่มโชว์เสมอ ไม่ต้องกดขยาย (พื้นที่ราว 48dp) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/badge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:src="@drawable/notif_badge_in" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/notif_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_check"
                style="@style/NotifButton"
                android:background="@drawable/notif_btn_in"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/btn_skip"
                style="@style/NotifButton"
                android:layout_marginStart="6dp"
                android:background="@drawable/notif_btn_outline"
                android:text="ข้าม"
                android:textColor="@color/notif_outline_text" />

            <TextView
                android:id="@+id/btn_snooze"
                style="@style/NotifButton"
                android:layout_marginStart="6dp"
                android:background="@drawable/notif_btn_outline"
                android:textColor="@color/notif_outline_text" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
